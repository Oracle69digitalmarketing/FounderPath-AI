# FounderPath AI Environment Variables

# ---- AI Models ----
# The Gemini API Key (Required for default path)
GEMINI_API_KEY=

# Model Provider: gemini or nim
VITE_MODEL_PROVIDER=gemini

# NVIDIA NIM Configuration (if using nim)
VITE_NIM_ENDPOINT=https://integrate.api.nvidia.com/v1
VITE_NVIDIA_API_KEY=
VITE_NIM_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning

# ---- Firebase ----
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
